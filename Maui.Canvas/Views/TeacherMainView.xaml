<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.TeacherMainView"
             Title="Teacher Menu"
             NavigatedTo="ContentPage_NavigatedTo">

	<VerticalStackLayout>

		<Label Text="Teacher Menu"
               HorizontalOptions="Center" />

		<CollectionView ItemsSource="{Binding Courses}"
                        SelectedItem="{Binding SelectedCourse}"
                        SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>
						<Label Text="{Binding Name}" Grid.Column="0" />
						<Label Text="{Binding Code}" Grid.Column="1" />
						<Label Text="{Binding Semester}" Grid.Column="2" />
						<Label Text="{Binding Section}" Grid.Column="3" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Button Text="Open Course" Clicked="OpenCourseClicked" />
		<Button Text="Manage Students" Clicked="ManageStudentsClicked" />
		<Button Text="Go Back" Clicked="GoBackClicked" />

	</VerticalStackLayout>
</ContentPage>
