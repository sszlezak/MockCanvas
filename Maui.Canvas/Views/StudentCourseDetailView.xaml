<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.StudentCourseDetailView"
             Title="Student Course Detail"
             NavigatedTo="ContentPage_NavigatedTo">

	<VerticalStackLayout>

		<Label Text="{Binding CourseTitle}" FontAttributes="Bold" HorizontalOptions="Center" />

		<!-- Letter Grade (Issue 6) -->
		<Label Text="{Binding LetterGrade, StringFormat='Current Grade: {0}'}" FontAttributes="Bold" HorizontalOptions="Center" />
		<Label Text="{Binding CourseAverage, StringFormat='Average: {0}'}" HorizontalOptions="Center" />

		<!-- Assignments -->
		<Label Text="Assignments" FontAttributes="Bold" />
		<CollectionView ItemsSource="{Binding Assignments}">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Label Text="{Binding Name}" Grid.Column="0" VerticalOptions="Center" />
						<Label Text="{Binding DueDate, StringFormat='{0:MM/dd/yyyy}'}" Grid.Column="1" VerticalOptions="Center" />
						<Label Text="{Binding AvailablePoints, StringFormat='{0} pts'}" Grid.Column="2" VerticalOptions="Center" />
						<Button Text="Submit" Grid.Column="3"
                                Clicked="SubmitAssignmentClicked"
                                CommandParameter="{Binding .}" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- Grades -->
		<Label Text="Grades" FontAttributes="Bold" />
		<CollectionView ItemsSource="{Binding Grades}">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>
						<Label Text="{Binding AssignmentName}" Grid.Column="0" />
						<Label Text="{Binding Grade}" Grid.Column="1" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- Modules -->
		<Label Text="Modules" FontAttributes="Bold" />
		<CollectionView ItemsSource="{Binding Modules}">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<VerticalStackLayout>
						<Label Text="{Binding Header}" FontAttributes="Bold" />
						<CollectionView ItemsSource="{Binding Items}">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Label Text="{Binding ContentType, StringFormat='[{0}]'}" Grid.Column="0" />
										<Label Text="{Binding Title}" Grid.Column="1" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</VerticalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<!-- Roster -->
		<Label Text="Students in Course" FontAttributes="Bold" />
		<CollectionView ItemsSource="{Binding Roster}">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Label Text="{Binding DisplayName}" />
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Button Text="Go Back" Clicked="GoBackClicked" />

	</VerticalStackLayout>
</ContentPage>
