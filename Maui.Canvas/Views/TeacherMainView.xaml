<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.TeacherMainView"
             Title="TeacherMenu">
	<VerticalStackLayout Padding="30" Spacing="20">

		<Label Text="Teacher Menu"
           FontSize="28"
           FontAttributes="Bold"
           HorizontalOptions="Center" />

		<Button Text="Add New Course" />

		<Button Text="Select Existing Course" />

		<Button Text="View Courses by Semester" />

		<Button Text="Go Back"
            Clicked="GoBackClicked"/>

	</VerticalStackLayout>
</ContentPage>