<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.StudentSubmissionView"
             Title="Submit Assignment"
             NavigatedTo="ContentPage_NavigatedTo">

	<VerticalStackLayout>

		<Label x:Name="AssignmentInfoLabel" FontAttributes="Bold" />
		<Label x:Name="AssignmentDescLabel" />
		<Label x:Name="StatusLabel" />

		<Label Text="Your Response:" />
		<Editor x:Name="ResponseEntry"
                Placeholder="Type your response here..."
                MinimumHeightRequest="120" />

		<Button x:Name="SubmitButton" Text="Submit" Clicked="SubmitClicked" />
		<Button Text="Go Back" Clicked="GoBackClicked" />

	</VerticalStackLayout>
</ContentPage>
