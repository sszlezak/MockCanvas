<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.ModuleDetailView"
             Title="Module Detail"
			 NavigatedTo="ContentPage_NavigatedTo">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="10">

			<Label Text="{Binding Id, StringFormat='Module {0}'}" FontAttributes="Bold" FontSize="20" />

			<Label Text="Module Content" FontAttributes="Bold" />

			<CollectionView ItemsSource="{Binding Content}">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Grid Padding="5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="4*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Label Text="{Binding Title}" VerticalOptions="Center" />
							<Button Text="Edit"
                                    Grid.Column="1"
                                    Clicked="EditContentClicked"
                                    CommandParameter="{Binding .}" />
							<Button Text="Delete"
                                    Grid.Column="2"
                                    Clicked="DeleteContentClicked"
                                    CommandParameter="{Binding .}" />
						</Grid>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Button Text="Add Page" Clicked="AddPageClicked" />
			<Button Text="Add File" Clicked="AddFileClicked" />
			<Button Text="Add Assignment Reference" Clicked="AddAssignmentRefClicked" />

			<Button Text="Save Module" Clicked="OkClicked" />
			<Button Text="Cancel" Clicked="GoBackClicked" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>