<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.StudentManagementView"
             Title="Student Management"
             NavigatedTo="ContentPage_NavigatedTo">

	<VerticalStackLayout>

		<Label Text="University Students"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

		<CollectionView ItemsSource="{Binding Students}"
                        SelectedItem="{Binding SelectedStudent}"
                        SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Grid Padding="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Label Text="{Binding DisplayName}" Grid.Column="0" VerticalOptions="Center" />
						<Label Text="{Binding Classification}" Grid.Column="1" VerticalOptions="Center" />
						<Button Text="Edit"
                                Grid.Column="2"
                                Clicked="EditStudentClicked"
                                CommandParameter="{Binding .}" />
						<Button Text="Remove"
                                Grid.Column="3"
                                Clicked="RemoveStudentClicked"
                                CommandParameter="{Binding .}" />
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<Button Text="Add New Student" Clicked="AddStudentClicked" />
		<Button Text="Go Back" Clicked="GoBackClicked" />

	</VerticalStackLayout>
</ContentPage>