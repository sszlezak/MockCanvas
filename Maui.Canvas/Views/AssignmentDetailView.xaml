<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.AssignmentDetailView"
             Title="Assignment Detail"
             NavigatedTo="ContentPage_NavigatedTo">

	<VerticalStackLayout Padding="20" Spacing="10">

		<Label Text="Name:" />
		<Entry Text="{Binding Name}" />

		<Label Text="Description:" />
		<Entry Text="{Binding Description}" />

		<Label Text="Available Points:" />
		<Entry Text="{Binding AvailablePoints}" Keyboard="Numeric" />

		<Label Text="Due Date:" />
		<DatePicker Date="{Binding DueDate}" />

		<Button Text="OK" Clicked="OkClicked" />
		<Button Text="Cancel" Clicked="GoBackClicked" />

	</VerticalStackLayout>
</ContentPage>